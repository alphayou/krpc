{
  "name": "@alphayou/krpc",
  "version": "0.1.0",
  "description": "Type-safe, zero-dependency JSON-RPC 2.0 library for TypeScript built on Web Standard APIs",
  "license": "MPL-2.0",
  "author": {
    "name": "Alpha You",
    "email": "oss@alphayou.io",
    "url": "https://github.com/alphayou"
  },
  "keywords": [
    "json-rpc",
    "json-rpc-2",
    "rpc",
    "typescript",
    "type-safe",
    "standard-schema",
    "zero-dependency",
    "web-standards",
    "http",
    "websocket",
    "streams"
  ],
  "homepage": "https://github.com/alphayou/krpc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphayou/krpc.git"
  },
  "bugs": {
    "url": "https://github.com/alphayou/krpc/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./http": {
      "types": "./dist/http.d.mts",
      "import": "./dist/http.mjs"
    },
    "./ws": {
      "types": "./dist/ws.d.mts",
      "import": "./dist/ws.mjs"
    },
    "./bun": {
      "types": "./dist/bun.d.mts",
      "import": "./dist/bun.mjs"
    },
    "./stream": {
      "types": "./dist/stream.d.mts",
      "import": "./dist/stream.mjs"
    },
    "./stdio": {
      "types": "./dist/stdio.d.mts",
      "import": "./dist/stdio.mjs"
    },
    "./port": {
      "types": "./dist/port.d.mts",
      "import": "./dist/port.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "bench": "bun run bench/rpc.bench.ts",
    "typecheck": "bun check",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "verify": "bun run format:check && bun run typecheck && bun run test",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "typescript": "^7"
  }
}
